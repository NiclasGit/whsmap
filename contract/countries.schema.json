{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Atlas Countries Payload",
  "type": "object",
  "required": ["generatedAt", "countries"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "iso3",
          "name",
          "aliases",
          "teaser",
          "bbox",
          "counts",
          "richness",
          "richnessRaw",
          "spread",
          "climate",
          "cost",
          "safety",
          "traditions"
        ],
        "additionalProperties": false,
        "properties": {
          "iso3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "teaser": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "counts": {
            "type": "object",
            "required": ["unesco", "notable", "byCategory"],
            "additionalProperties": false,
            "properties": {
              "unesco": { "type": "integer", "minimum": 0 },
              "notable": { "type": "integer", "minimum": 0 },
              "byCategory": {
                "type": "object",
                "required": [
                  "ancient",
                  "sacred",
                  "castles",
                  "towns",
                  "palaces",
                  "landscapes",
                  "modern",
                  "natural"
                ],
                "additionalProperties": false,
                "properties": {
                  "ancient": { "type": "integer", "minimum": 0 },
                  "sacred": { "type": "integer", "minimum": 0 },
                  "castles": { "type": "integer", "minimum": 0 },
                  "towns": { "type": "integer", "minimum": 0 },
                  "palaces": { "type": "integer", "minimum": 0 },
                  "landscapes": { "type": "integer", "minimum": 0 },
                  "modern": { "type": "integer", "minimum": 0 },
                  "natural": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "richness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "richnessRaw": {
            "type": "integer",
            "minimum": 0
          },
          "spread": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["level", "medianKm"],
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": ["compact", "moderate", "spread"]
                  },
                  "medianKm": { "type": "number", "minimum": 0 }
                }
              }
            ]
          },
          "climate": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["tempC", "precipMm", "comfortable"],
                "additionalProperties": false,
                "properties": {
                  "tempC": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12,
                    "items": { "type": "number" }
                  },
                  "precipMm": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12,
                    "items": { "type": "number", "minimum": 0 }
                  },
                  "comfortable": {
                    "type": "array",
                    "minItems": 12,
                    "maxItems": 12,
                    "items": { "type": "boolean" }
                  }
                }
              }
            ]
          },
          "cost": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["tier", "priceLevelRatio", "year"],
                "additionalProperties": false,
                "properties": {
                  "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "priceLevelRatio": { "type": "number", "minimum": 0 },
                  "year": { "type": "integer", "minimum": 1990 }
                }
              }
            ]
          },
          "safety": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["level", "label", "url", "asOf"],
                "additionalProperties": false,
                "properties": {
                  "level": { "type": "integer", "minimum": 1, "maximum": 4 },
                  "label": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "minLength": 1 },
                  "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            ]
          },
          "traditions": {
            "type": "object",
            "required": ["count", "examples"],
            "additionalProperties": false,
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "examples": {
                "type": "array",
                "maxItems": 5,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
