{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Atlas Country Sites GeoJSON",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "const": "Feature" },
          "id": { "type": "integer", "minimum": 0 },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "const": "Point" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "siteId",
              "name",
              "category",
              "unesco",
              "inDanger",
              "yearInscribed",
              "fame",
              "fameLevel",
              "summary",
              "summarySource",
              "image",
              "wikipediaUrl",
              "unescoUrl",
              "wikidataId",
              "countries"
            ],
            "additionalProperties": false,
            "properties": {
              "siteId": {
                "type": "string",
                "pattern": "^(whs-\\d+|wd-Q\\d+)$"
              },
              "name": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": [
                  "ancient",
                  "sacred",
                  "castles",
                  "towns",
                  "palaces",
                  "landscapes",
                  "modern",
                  "natural"
                ]
              },
              "unesco": { "type": "boolean" },
              "inDanger": { "type": "boolean" },
              "yearInscribed": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "integer", "minimum": 1978 }
                ]
              },
              "fame": { "type": "integer", "minimum": 0 },
              "fameLevel": { "type": "integer", "enum": [1, 2, 3, 4] },
              "summary": { "type": "string" },
              "summarySource": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "enum": ["unesco", "wikipedia"] }
                ]
              },
              "image": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["thumbUrl", "author", "license", "sourceUrl"],
                    "additionalProperties": false,
                    "properties": {
                      "thumbUrl": { "type": "string", "minLength": 1 },
                      "author": { "type": "string", "minLength": 1 },
                      "license": { "type": "string", "minLength": 1 },
                      "sourceUrl": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              },
              "wikipediaUrl": {
                "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
              },
              "unescoUrl": {
                "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
              },
              "wikidataId": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "^Q\\d+$" }
                ]
              },
              "countries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
